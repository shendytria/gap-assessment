# Database PostgreSQL (sesuai docker-compose.yml)
DATABASE_URL=postgres://postgres:password123@127.0.0.1:5432/gap_db?sslmode=disable

# Port HTTP server
PORT=8080

# Di local development (HTTP) set false agar browser menerima cookie
COOKIE_SECURE=false

# Origin frontend yang diizinkan (CORS & Same-origin check)
ALLOWED_ORIGINS=http://localhost:3000
