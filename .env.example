# =============================================================================
# GAP ASSESSMENT ONLINE - UNIFIED ENVIRONMENT TEMPLATE (.env.example)
# Panduan: Salin file ini menjadi .env (`cp .env.example .env`) di root repo,
# lalu ganti seluruh nilai CHANGE_ME sesuai environment lokal / server.
# Satu file .env di root dipakai bersama oleh Backend (Go) & Frontend (Next.js).
# =============================================================================

# --- Backend Configuration ---
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/gap_db?sslmode=disable
PORT=8080
JWT_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_MIN_32_CHARS
COOKIE_NAME=gap_session

# PERHATIAN COOKIE_SECURE:
# - Set 'true' jika aplikasi diakses lewat HTTPS (https://...).
# - Set 'false' jika aplikasi diakses lewat HTTP biasa / IP intranet (misal http://10.10.x.x:3000).
COOKIE_SECURE=false

# PERHATIAN ALLOWED_ORIGINS:
# Masukkan origin tempat web dibuka di browser (pisah koma untuk multi-IP/domain).
# Contoh: http://10.10.1.50:3000,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- SMTP Mail Relay ---
SMTP_HOST=CHANGE_ME
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=CHANGE_ME@example.com
SMTP_SECURE=false

# --- Initial Admin Account (Auto-Seeded saat backend pertama kali jalan) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@kalbeconsumerhealth.co.id
INITIAL_ADMIN_PASSWORD=Gap12345
INITIAL_ADMIN_FULLNAME=System Administrator

# --- Frontend Endpoints & Internal Proxy ---
BACKEND_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_LOGIN_URL=/login

# --- Security Policies ---
SESSION_IDLE_MINUTES=30
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_HISTORY=5
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
DEFAULT_PASSWORD=Gap12345
BCRYPT_COST=12
