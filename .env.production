# =============================================================================
# GAP ASSESSMENT ONLINE - UNIFIED PRODUCTION ENVIRONMENT (.env.production)
# Panduan untuk Tim IT: Sesuaikan nilai di bawah dengan IP/domain server deployment.
# =============================================================================

# --- Backend Configuration ---
DATABASE_URL=postgres://postgres:password123@127.0.0.1:5432/gap_db?sslmode=disable
PORT=8080
JWT_SECRET_KEY=gap-assessment-production-secret-key-kalbe-2026!
COOKIE_NAME=gap_session

# PERHATIAN COOKIE_SECURE:
# - Set 'true' HANYA jika aplikasi diakses lewat HTTPS (https://...).
# - Set 'false' jika aplikasi diakses lewat HTTP biasa / IP intranet (misal http://10.10.x.x:3000).
#   (Jika pakai http tapi ini di-set true, browser akan menolak cookie dan login akan gagal!)
COOKIE_SECURE=false

# PERHATIAN ALLOWED_ORIGINS:
# Masukkan link/IP tempat user membuka web di browser (bisa lebih dari satu, pisahkan dengan koma).
# Contoh: http://10.10.1.50:3000,http://10.10.2.60:3000,https://gapassessment.kalbeconsumerhealth.co.id
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://gapassessmentonline.kalbeconsumerhealth.co.id

# --- SMTP Mail Relay (Kalbe Consumer Health Outlook Relay) ---
SMTP_HOST=kalbeconsumerhealth-com.mail.protection.outlook.com
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=notifikasi.gapassessmentonline@kalbeconsumerhealth.co.id
SMTP_SECURE=false

# --- Initial Admin Account (Auto-Provisioned pada Startup Pertama) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@kalbeconsumerhealth.co.id
INITIAL_ADMIN_PASSWORD=Gap12345
INITIAL_ADMIN_FULLNAME=System Administrator

# --- Frontend Endpoints & Internal Proxy ---
# BACKEND_URL: Alamat internal Next.js menuju ke Go Backend (biasanya http://127.0.0.1:8080 di server yang sama)
BACKEND_URL=http://127.0.0.1:8080
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_LOGIN_URL=/login

# --- Security Policies ---
SESSION_IDLE_MINUTES=30
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_HISTORY=5
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
DEFAULT_PASSWORD=Gap12345
BCRYPT_COST=12
